<Window x:Class="HTMarkdownNote.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HT Markdown Note" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Loaded="Window_Loaded">
    <DockPanel>
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="50" Background="White" Padding="10" Spacing="10" VerticalAlignment="Center">
            <Button Name="NewNoteButton" Width="100" Height="40" Content="+ 新建便签" Click="NewNoteButton_Click" Background="#0078D4" Foreground="White" FontSize="14" Cursor="Hand"/>
            <TextBox Name="SearchBox" Width="250" Height="40" Padding="10" TextChanged="SearchBox_TextChanged"/>
            <Button Name="SettingsButton" Width="100" Height="40" Content="设置" Background="#E1E1E1" FontSize="14" Cursor="Hand"/>
        </StackPanel>

        <!-- 便签列表 -->
        <ListBox Name="NoteListBox" DockPanel.Dock="Bottom" ItemsSource="{Binding DisplayNotes}" Background="White" MouseDoubleClick="NoteListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Height="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <!-- 便签内容 -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" Spacing="5">
                                <TextBlock Name="TitleBlock" FontWeight="Bold" FontSize="14" Foreground="#333" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Name="PreviewBlock" FontSize="12" Foreground="#666" Text="{Binding Preview}" TextTrimming="WordEllipsis" Height="45" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 操作菜单 -->
                            <Button Grid.Column="1" Width="40" Height="40" Content="⋯" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" Foreground="#999" FontSize="18" Cursor="Hand" Click="MoreButton_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>